### Змінні оточення
@host = http://localhost:8081
@auth_user = Basic dXNlcjp1c2Vy
@auth_admin = Basic YWRtaW46YWRtaW4=
@auth_superadmin = Basic c3VwZXJhZG1pbjpzdXBlcmFkbWlu
@auth_invalid = Basic d3Jvbmc6cGFzc3dvcmQ=




### 1. ПУБЛІЧНІ МАРШРУТИ (БЕЗ АВТОРИЗАЦІЇ)

### 1.1 Перевірка головної сторінки (очікується 200)
GET {{host}}/index.html

> {%
    client.test("Status is 200", function() {
        client.assert(response.status === 200, "Response status is not 200");
    });
%}

### 1.2 Неавторизований запит на захищений маршрут (очікується 401)
GET {{host}}/api/v1/cars
Accept: application/json

> {%
    client.test("Status is 401 Unauthorized", function() {
        client.assert(response.status === 401, "Expected 401 Unauthorized");
    });
%}

### 1.3 Запит з неправильним паролем (очікується 401)
GET {{host}}/api/v1/cars
Authorization: {{auth_invalid}}

> {%
    client.test("Status is 401 for wrong credentials", function() {
        client.assert(response.status === 401, "Expected 401 Unauthorized");
    });
%}


### 2. ТЕСТОВІ ЕНДПОІНТИ ПРИВІТАННЯ (/hello/...)

### 2.1 HELLO USER - користувач USER (успіх, очікується 200)
GET {{host}}/api/v1/cars/hello/user
Authorization: {{auth_user}}

> {%
    client.test("User successfully accesses hello/user", function() {
        client.assert(response.status === 200, "Response status is not 200");
    });
%}

### 2.2 HELLO USER - користувач ADMIN (заборонено PreAuthorize, очікується 403)
GET {{host}}/api/v1/cars/hello/user
Authorization: {{auth_admin}}

> {%
    client.test("Admin forbidden from hello/user", function() {
        client.assert(response.status === 403, "Expected 403 Forbidden");
    });
%}

### 2.3 HELLO ADMIN - користувач ADMIN (успіх, очікується 200)
GET {{host}}/api/v1/cars/hello/admin
Authorization: {{auth_admin}}

> {%
    client.test("Admin successfully accesses hello/admin", function() {
        client.assert(response.status === 200, "Response status is not 200");
    });
%}


### 2.4 HELLO ADMIN - користувач USER (заборонено, очікується 403)
GET {{host}}/api/v1/cars/hello/admin
Authorization: {{auth_user}}

> {%
    client.test("User forbidden from hello/admin", function() {
        client.assert(response.status === 403, "Expected 403 Forbidden");
    });
%}



### 2.5 HELLO MAN - користувач ADMIN (успіх, очікується 200)
GET {{host}}/api/v1/cars/hello/man
Authorization: {{auth_admin}}

> {%
    client.test("Admin successfully accesses hello/man", function() {
        client.assert(response.status === 200, "Response status is not 200");
    });
%}

### 2.6 HELLO MAN - користувач SUPERADMIN (успіх, очікується 200)
GET {{host}}/api/v1/cars/hello/man
Authorization: {{auth_superadmin}}

> {%
    client.test("SuperAdmin successfully accesses hello/man", function() {
        client.assert(response.status === 200, "Response status is not 200");
    });
%}

### 2.7 HELLO UNKNOWN - будь-який автентифікований користувач (успіх, очікується 200)
GET {{host}}/api/v1/cars/hello/unknown
Authorization: {{auth_user}}

> {%
    client.test("Authenticated user accesses hello/unknown", function() {
        client.assert(response.status === 200, "Response status is not 200");
    });
%}

###############################################################################
### 3. REST CRUD ОПЕРАЦІЇ (/api/v1/cars)
###############################################################################

### 3.1 Отримати список авто - USER (успіх, очікується 200)
GET {{host}}/api/v1/cars
Authorization: {{auth_user}}
Accept: application/json

> {%
    client.test("Status is 200", function() {
        client.assert(response.status === 200, "Response status is not 200");
    });
%}

### 3.2 Створення авто - заборонено для USER (очікується 403)
POST {{host}}/api/v1/cars
Authorization: {{auth_user}}
Content-Type: application/json

{
  "name": "Tesla Model S",
  "price": 80000
}

> {%
    client.test("User cannot create car", function() {
        client.assert(response.status === 403, "Expected 403 Forbidden");
    });
%}

### 3.3 Створення авто - ADMIN (успіх, очікується 200)
POST {{host}}/api/v1/cars
Authorization: {{auth_admin}}
Content-Type: application/json

{
  "name": "BMW M5",
  "price": 105000
}

> {%
    client.test("Admin successfully creates car", function() {
        client.assert(response.status === 200, "Response status is not 200");
    });
%}

### 3.4 Отримати авто за ID - USER (успіх, очікується 200)
GET {{host}}/api/v1/cars/1
Authorization: {{auth_user}}
Accept: application/json

### 3.5 Оновлення авто - заборонено для USER (очікується 403)
PUT {{host}}/api/v1/cars
Authorization: {{auth_user}}
Content-Type: application/json

{
  "id": "1",
  "name": "BMW M5 Competition",
  "price": 115000
}

> {%
    client.test("User cannot update car", function() {
        client.assert(response.status === 403, "Expected 403 Forbidden");
    });
%}

### 3.6 Оновлення авто - ADMIN (успіх, очікується 200)
PUT {{host}}/api/v1/cars
Authorization: {{auth_admin}}
Content-Type: application/json

{
  "id": "1",
  "name": "BMW M5 Competition",
  "price": 115000
}

> {%
    client.test("Admin successfully updates car", function() {
        client.assert(response.status === 200, "Response status is not 200");
    });
%}

### 3.7 Видалення авто - заборонено для ADMIN (очікується 403)
DELETE {{host}}/api/v1/cars/1
Authorization: {{auth_admin}}

> {%
    client.test("Admin cannot delete car", function() {
        client.assert(response.status === 403, "Expected 403 Forbidden");
    });
%}

### 3.8 Видалення авто - дозволено тільки SUPERADMIN (успіх, очікується 200)
DELETE {{host}}/api/v1/cars/1
Authorization: {{auth_superadmin}}

> {%
    client.test("SuperAdmin successfully deletes car", function() {
        client.assert(response.status === 200, "Response status is not 200");
    });
%}